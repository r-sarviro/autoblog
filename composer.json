{
  "name": "auto-blog/blog",
  "description": "Simple PHP blog with categories and articles",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "smarty/smarty": "^4.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "seed": "php database/seeders/seed.php"
  }
}
